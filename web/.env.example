# Backend API base URL.
#
# Leave this UNSET for local dev: the app then uses a relative base and the
# Vite dev proxy forwards /api to the backend (avoids browser CORS).
# Point the proxy at a local backend with VITE_DEV_API_TARGET instead, e.g.:
#   VITE_DEV_API_TARGET=http://localhost:8000
#
# Set VITE_API_BASE_URL only to force an absolute base (e.g. in production
# builds, or to bypass the proxy):
#   VITE_API_BASE_URL=https://api.pdftoreel.com
